# === Database ===
DATABASE_URL=postgresql://reelcraft:reelcraft@localhost:15432/reelcraft

# === Redis ===
REDIS_URL=redis://localhost:16379

# === Storage (S3-compatible: dev=MinIO, prod=R2) ===
STORAGE_TYPE=local
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_ACCESS_KEY=reelcraft
STORAGE_SECRET_KEY=reelcraft-dev-secret
STORAGE_BUCKET=reelcraft

# === Auth ===
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:3000

# === AI Providers (per-user BYO keys come in M3; server keys for now) ===
OPENROUTER_API_KEY=
FAL_KEY=
ATLASCLOUD_API_KEY=

# === Workers ===
QUEUE_CONCURRENCY_TEXT=8
QUEUE_CONCURRENCY_IMAGE=10
QUEUE_CONCURRENCY_VIDEO=4
QUEUE_CONCURRENCY_VOICE=8
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000

# === Quotas + rate limits ===
# Per-user concurrent worker slots (Redis distributed semaphore).
QUOTA_USER_CONCURRENT_IMAGE=4
QUOTA_USER_CONCURRENT_VIDEO=2
# Per-user daily API call caps (48h TTL window).
QUOTA_DAILY_IMAGE=200
QUOTA_DAILY_VIDEO=50

# === Billing ===
BILLING_MODE=SHADOW

# === Logging ===
LOG_LEVEL=info

# === BYO-Key encryption (REQUIRED in production) ===
API_ENCRYPTION_KEY=dev-only-encryption-key-change-me

# === API rate limit (per user, sliding window) ===
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_READ_MAX=600
RATE_LIMIT_WRITE_MAX=120
