    },
    {
      "id": "voice_analyze",
      "path": "pipeline/voice_analyze.zh.txt",
      "version": "1",
      "variables": [
        "scene_text",
        "shot_list_json"
      ],
      "description": "抽對白台詞，標說話者/情緒/情緒強度(≤0.5)/對應鏡頭（JSON）。"
    },
    {
      "id": "image_prompt_shot",
      "path": "pipeline/image_prompt_shot.zh.txt",
      "version": "3",
      "variables": [
        "shot_json",
        "reference_legend",
        "locked_assets",
        "style_suffix"
