    },
    {
      "id": "storyboard_photography",
      "path": "pipeline/storyboard_photography.zh.txt",
      "version": "1",
      "variables": [
        "shot_list_json"
      ],
      "description": "分鏡第②階段攝影：逐鏡光線/景深/色調，對白多臉強制淺景深（JSON）。"
    },
    {
      "id": "storyboard_acting",
      "path": "pipeline/storyboard_acting.zh.txt",
      "version": "1",
      "variables": [
        "shot_list_json"
      ],
      "description": "分鏡第③階段表演：抽象情緒詞翻成可見動作與表情（JSON）。"
    },
    {
      "id": "storyboard_detail",
      "path": "pipeline/storyboard_detail.zh.txt",
      "version": "1",
      "variables": [
        "shot_list_json",
