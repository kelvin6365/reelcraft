        "novel_text",
        "style_note"
      ],
      "description": "小說改寫成分場短劇劇本，30-60 秒/場，防偷懶（純文字）。"
    },
    {
      "id": "build_scenes",
      "path": "pipeline/build_scenes.zh.txt",
      "version": "1",
      "variables": [
        "script_text"
      ],
      "description": "劇本切場景，只回傳起訖文字錨點供程式定位，約 20 元素/場（JSON）。"
