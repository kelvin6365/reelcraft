{
  "name": "reelcraft",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stable": "WORKER_WATCH=0 node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "db:migrate": "prisma migrate dev",
    "sync:prices": "tsx scripts/sync-prices.ts",
    "sync:prices:check": "tsx scripts/sync-prices.ts --check",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "smoke:ai": "tsx --env-file=.env scripts/smoke-ai.ts",
    "worker": "tsx watch --env-file=.env src/lib/workers/index.ts",
    "worker:once": "tsx --env-file=.env src/lib/workers/index.ts",
    "watchdog": "tsx watch --env-file=.env src/lib/workers/watchdog.ts",
    "smoke:task": "MODEL_DEFAULTS_PRESET=fake tsx --env-file=.env scripts/smoke-task.ts",
    "smoke:pipeline": "MODEL_DEFAULTS_PRESET=fake tsx --env-file=.env scripts/smoke-pipeline.ts",
    "smoke:pipeline:local": "node scripts/smoke-pipeline-local.mjs",
    "smoke:plan": "MODEL_DEFAULTS_PRESET=fake tsx --env-file=.env scripts/smoke-plan.ts",
    "smoke:srt": "MODEL_DEFAULTS_PRESET=fake tsx --env-file=.env scripts/smoke-srt.ts",
    "smoke:batch": "MODEL_DEFAULTS_PRESET=fake tsx --env-file=.env scripts/smoke-batch.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@prisma/client": "^6.5.0",
    "@tanstack/react-query": "^5.101.3",
    "better-auth": "^1.2.0",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^5.4.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.20",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
